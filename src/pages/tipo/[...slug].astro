---
import TypePage from '../../components/pages/TypePage.astro';
import typeData from '../../data/type-data.json';
import { parseTypeSlug, canonicalTypeSlug } from '../../lib/seo.js';

const { slug } = Astro.params;
const { types } = typeData;

const parsed = parseTypeSlug(slug, types);
if (!parsed) return Astro.rewrite('/404');

// One URL per combination: /tipo/flying-fire and /tipo/fire-fire permanently
// redirect to /tipo/fire-flying and /tipo/fire.
const canonicalSlug = canonicalTypeSlug(parsed, types);
if (slug !== canonicalSlug) return Astro.redirect(`/tipo/${canonicalSlug}`, 301);
---

<TypePage lang="en" canonicalSlug={canonicalSlug} />
