---
import Layout from '../../layouts/Layout.astro';
import AppHeader from '../../components/AppHeader.astro';
import TypeSelectorField from '../../components/TypeSelectorField.astro';
import typeData from '../../data/type-data.json';
import { calculateDefense, calculateOffense } from '../../lib/type-engine/index.js';

const { slug } = Astro.params;
const { types, effectiveness, contrast } = typeData;

let t1 = null;
let t2 = null;
let t3 = null;

if (slug) {
    const parts = slug.split('-');
    const findType = (s: string) => types.find(t => t.toLowerCase() === s.toLowerCase());
    t1 = findType(parts[0]) || null;
    t2 = parts[1] ? findType(parts[1]) || null : null;
    t3 = parts[2] ? findType(parts[2]) || null : null;
}

if (!t1) return Astro.redirect('/404');

// ── HTML helpers ─────────────────────────────────────────────────────────────

const contrastMap = contrast as Record<string, string>;

function pill(type: string): string {
    const tc = contrastMap[type] === 'dark' ? 'type-text-dark' : 'type-text-light';
    return `<span class="type-pill bg-type-${type.toLowerCase()} ${tc}">${type}</span>`;
}

function pills(list: string[]): string {
    return list.length
        ? list.map(pill).join('')
        : `<span class="text-xs font-bold uppercase tracking-widest" style="color: var(--text-muted)">None</span>`;
}

const MULT_LABELS: Record<string, string> = { '8': '8×', '4': '4×', '2': '2×', '1': '1×', '05': '½×', '025': '¼×', '0125': '⅛×', '0': '0×' };

function multRow(mult: string, severityClass: string, typeList: string[]): string {
    if (!typeList.length) return '';
    return `<div class="flex items-start gap-3"><span class="mult-badge ${severityClass} shrink-0">${MULT_LABELS[mult]}</span><div class="type-pills-container pt-1">${pills(typeList)}</div></div>`;
}

function section(title: string, rows: string[]): string {
    const filtered = rows.filter(Boolean);
    if (!filtered.length) return '';
    return `<div class="mb-4 last:mb-0"><div class="text-[11px] font-bold uppercase tracking-widest mb-2" style="color: var(--text-muted)">${title}</div><div class="flex flex-col gap-2.5">${filtered.join('')}</div></div>`;
}

// ── Compute ───────────────────────────────────────────────────────────────────

const def = calculateDefense(t1, t2, types, effectiveness, t3);
const off = calculateOffense(t1, t2, types, effectiveness, t3);

const defenseSections = [
    section('Critical', [multRow('8', 'mult-critical', def.weaknesses8x), multRow('4', 'mult-critical', def.weaknesses4x)]),
    section('Weak', [multRow('2', 'mult-weak', def.weaknesses2x)]),
    section('Immune', [multRow('0', 'mult-immune', def.immunities)]),
    section('Resists', [multRow('05', 'mult-resist', def.resistances05x)]),
    section('Strong Resists', [multRow('025', 'mult-resist', def.resistances025x), multRow('0125', 'mult-resist', def.resistances0125x)]),
    section('Neutral', [multRow('1', 'mult-neutral', def.neutral)])
].filter(Boolean);
const defenseGroupsHtml = defenseSections.join('');

const offenseSections = [
    section('Super Effective', [multRow('2', 'mult-critical', off.superEffective2x)]),
    section('Neutral', [multRow('1', 'mult-neutral', off.neutral)]),
    section('Not Very Effective', [multRow('05', 'mult-resist', off.notVeryEffective)]),
    section('No Effect', [multRow('0', 'mult-immune', off.noEffect)])
].filter(Boolean);
const offenseGroupsHtml = offenseSections.join('');

const selectedTypeHtml = [t1, t2, t3].filter(Boolean).map(t => pill(t!)).join('');

// ── Meta ──────────────────────────────────────────────────────────────────────

const typeName = [t1, t2, t3].filter(Boolean).join('/');
const title = `${typeName} Type Weaknesses, Resistances & Chart | PokeTypes`;
const description = `${typeName} type weakness chart: full effectiveness analysis, resistances, and immunities for Gen 9 (Scarlet & Violet). See every type that beats ${typeName} and every type ${typeName} beats.`;
const canonicalPath = `/tipo/${slug}`;
const siteUrl = 'https://poketypes.app';

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${siteUrl}${canonicalPath}#breadcrumb`,
    "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "PokeTypes", "item": `${siteUrl}/` },
        { "@type": "ListItem", "position": 2, "name": `${typeName} Type`, "item": `${siteUrl}${canonicalPath}` }
    ]
};

const webPageSchema = {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${siteUrl}${canonicalPath}`,
    "url": `${siteUrl}${canonicalPath}`,
    "name": title,
    "description": description,
    "isPartOf": { "@id": `${siteUrl}/#webapp` },
    "breadcrumb": { "@id": `${siteUrl}${canonicalPath}#breadcrumb` }
};
---

<Layout title={title} description={description}>
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
        <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageSchema)} />
    </Fragment>
    <div class="max-w-7xl mx-auto relative">
        <AppHeader contextLabel={typeName} />

        <div id="view-simple" class="flex flex-col gap-5">
            <section class="panel flex flex-col lg:flex-row items-stretch lg:items-center gap-3">
                <div class="relative w-full lg:flex-1">
                    <input id="pokemon-search" type="text" placeholder="Search Pokemon..." class="search-input" autocomplete="off">
                    <ul id="suggestions" class="hidden"></ul>
                </div>
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full lg:w-auto">
                    <TypeSelectorField selectId="type-select" placeholderKey="type_1" />
                    <TypeSelectorField selectId="type2-select" placeholderKey="type_2" />
                    <TypeSelectorField selectId="type3-select" placeholderKey="type_3" extra tooltipKey="type3_tooltip" />
                    <button id="reset-button" data-i18n="reset_btn" type="button" class="shrink-0 px-4 py-2.5 rounded-md text-sm font-bold transition-colors duration-150" style="color: var(--text-muted); border: 1px solid var(--border)">
                        Reset
                    </button>
                </div>
            </section>

            <section id="pokemon-hero" class="panel !py-2 hidden"></section>

            <section id="type-details" class="flex flex-col gap-5">
                <div class="panel !py-3 flex flex-wrap items-center justify-between gap-3">
                    <div id="selected-type-name" class="flex items-center gap-2" set:html={selectedTypeHtml}></div>
                    <button id="share-btn" class="icon-btn" title="Share Analysis" aria-label="Share Analysis" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                        </svg>
                    </button>
                </div>

                <div id="ability-alerts" class="hidden"></div>

                <div class="panel">
                    <div class="label-group">Defense</div>
                    <div id="defense-groups" set:html={defenseGroupsHtml}></div>
                </div>

                <div id="tactical-advice" class="hidden"></div>

                <div class="panel">
                    <div class="label-group">Offense</div>
                    <div id="offense-groups" set:html={offenseGroupsHtml}></div>
                </div>

                <section id="pokemon-stats" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div class="panel">
                        <div class="label-group">Base Stats</div>
                        <div id="stats-container" class="space-y-2.5"></div>
                    </div>
                    <div class="panel">
                        <div class="label-group">Abilities</div>
                        <div id="abilities-container" class="grid grid-cols-1 gap-2"></div>
                    </div>
                </section>
            </section>
        </div>
    </div>
    <script src="../../js/main.js"></script>
</Layout>
