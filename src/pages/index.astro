---
import Layout from '../layouts/Layout.astro';
import AppHeader from '../components/AppHeader.astro';
import TypeSelectorField from '../components/TypeSelectorField.astro';

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
        {
            "@type": "Question",
            "name": "What is the best Pokemon type?",
            "acceptedAnswer": { "@type": "Answer", "text": "The Steel type is widely considered the best defensive type due to its 10 resistances and 3 immunities. Offensively, Fairy and Ground are top-tier for their broad coverage in Gen 9 (Scarlet & Violet)." }
        },
        {
            "@type": "Question",
            "name": "How do you calculate dual type weaknesses?",
            "acceptedAnswer": { "@type": "Answer", "text": "Multiply the effectiveness modifiers of both types. If both types are weak to the same attacking type, damage becomes 4x (or even 8x with three types). Resistances can cancel weaknesses: a 2x weakness plus a 0.5x resistance equals 1x (neutral)." }
        },
        {
            "@type": "Question",
            "name": "What types are in Gen 9 (Scarlet & Violet)?",
            "acceptedAnswer": { "@type": "Answer", "text": "Gen 9 uses the same 18 types introduced in Gen 6: Normal, Fire, Water, Grass, Electric, Ice, Fighting, Poison, Ground, Flying, Psychic, Bug, Rock, Ghost, Dragon, Steel, Fairy, and Dark. The Terastal phenomenon lets any Pokemon temporarily change its type mid-battle." }
        },
        {
            "@type": "Question",
            "name": "What causes 0x (immune) damage in Pokemon?",
            "acceptedAnswer": { "@type": "Answer", "text": "Immunities cause 0x damage. Examples: Ghost types are immune to Normal and Fighting; Ground types are immune to Electric; Fairy types are immune to Dragon; Steel types are immune to Poison. Some abilities like Levitate also grant immunity." }
        }
    ]
};
---

<Layout title="PokeTypes | Pokemon Type Calculator & Effectiveness Chart" description="The most advanced Pokemon type calculator and effectiveness chart. Analyze weaknesses, resistances, and dual-type coverage for all 1,000+ Pokemon (Gen 9, Scarlet/Violet included).">
    <Fragment slot="head">
        <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
    </Fragment>
    <div class="max-w-7xl mx-auto relative">
        <AppHeader showModeSwitcher={true} />

        <!-- VIEW: SIMPLE (Calculator) -->
        <div id="view-simple" class="flex flex-col gap-5">

            <!-- Semantic page heading — small and unobtrusive by design; the
                 Calculator itself is the point, not a hero title. -->
            <h1 class="text-sm sm:text-base font-bold px-1" style="color: var(--text-muted)" data-i18n="home_h1">Pokemon Type Calculator &amp; Weakness Checker</h1>

            <!-- Control Center (Search & Type Selectors) -->
            <section class="panel flex flex-col lg:flex-row items-stretch lg:items-center gap-3">
                <div class="relative w-full lg:flex-1">
                    <input id="pokemon-search" type="text" placeholder="Search Pokemon..." data-i18n="search_placeholder" class="search-input" autocomplete="off">
                    <ul id="suggestions" class="hidden"></ul>
                </div>
                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 w-full lg:w-auto">
                    <TypeSelectorField selectId="type-select" placeholderKey="type_1" />
                    <TypeSelectorField selectId="type2-select" placeholderKey="type_2" />
                    <TypeSelectorField selectId="type3-select" placeholderKey="type_3" extra tooltipKey="type3_tooltip" />
                    <button id="reset-button" data-i18n="reset_btn" type="button" class="shrink-0 px-4 py-2.5 rounded-md text-sm font-bold transition-colors duration-150" style="color: var(--text-muted); border: 1px solid var(--border)">
                        Reset
                    </button>
                </div>
            </section>

            <!-- Empty State -->
            <section id="empty-state">
                <div class="panel text-center py-10 px-6">
                    <p class="text-sm font-bold uppercase tracking-widest mb-1" style="color: var(--text)" data-i18n="select_types">Select a type or Pokemon to begin analysis</p>
                    <p class="text-xs mb-5" style="color: var(--text-muted)" data-i18n="empty_state_hint">Click any type below to get started instantly</p>
                    <div id="empty-state-types" class="flex flex-wrap justify-center gap-1.5 max-w-2xl mx-auto"></div>
                </div>
            </section>

            <!-- Selected Pokemon / Type subject header -->
            <section id="pokemon-hero" class="panel !py-2 hidden"></section>

            <!-- Type Details (Defense-first) -->
            <section id="type-details" class="hidden flex flex-col gap-5">
                <div class="panel !py-3 flex flex-wrap items-center justify-between gap-3">
                    <div id="selected-type-name" class="flex items-center gap-2"></div>
                    <button id="share-btn" class="hidden icon-btn" title="Share Analysis" aria-label="Share Analysis" type="button">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                        </svg>
                    </button>
                </div>

                <div id="ability-alerts" class="hidden"></div>

                <!-- Defense: top priority -->
                <div class="panel">
                    <div class="label-group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="label-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2l7 4v6a8 8 0 01-7 8 8 8 0 01-7-8V6l7-4z" />
                        </svg>
                        <span data-i18n="defense_breakdown">Defense</span>
                    </div>
                    <div id="defense-groups"></div>
                </div>

                <div id="tactical-advice" class="hidden"></div>

                <!-- Offense: secondary -->
                <div class="panel">
                    <div class="label-group">
                        <svg xmlns="http://www.w3.org/2000/svg" class="label-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                        <span data-i18n="offense_breakdown">Offense</span>
                    </div>
                    <div id="offense-groups"></div>
                </div>

                <!-- Stats & Abilities (secondary, only for a selected Pokemon) -->
                <section id="pokemon-stats" class="hidden grid grid-cols-1 sm:grid-cols-2 gap-5">
                    <div class="panel">
                        <div class="label-group" data-i18n="base_stats">Base Stats</div>
                        <div id="stats-container" class="space-y-2.5"></div>
                    </div>
                    <div class="panel">
                        <div class="label-group" data-i18n="abilities">Abilities</div>
                        <div id="abilities-container" class="grid grid-cols-1 gap-2"></div>
                    </div>
                </section>
            </section>

            <!-- Full Type Chart — collapsible, secondary -->
            <details class="panel !p-0 overflow-hidden">
                <summary class="!p-5 cursor-pointer text-sm font-bold uppercase tracking-widest select-none" style="color: var(--text-muted)" data-i18n="global_chart">Global Type Chart</summary>
                <div class="overflow-x-auto px-4 pb-4">
                    <div id="type-table-container"></div>
                </div>
            </details>
        </div>

        <!-- VIEW: PRO (Team Builder) -->
        <div id="view-pro" class="hidden flex-col gap-8 sm:gap-10">
            <section>
                <div class="flex items-center justify-between mb-3 px-1">
                    <h2 class="text-sm font-bold uppercase tracking-widest" style="color: var(--text-muted)" data-i18n="pro_team_title">Your Team</h2>
                    <span id="team-count" class="text-sm font-medium" style="color: var(--text-muted)">0/6 Pokemon</span>
                </div>
                <div id="team-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
                    <button type="button" data-slot-action="add" onclick="window.openSearchModal(0)" class="team-slot-empty cursor-pointer panel border-dashed flex flex-col items-center justify-center h-28 transition-all group w-full">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--text-muted)">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        <span class="mt-2 text-[10px] uppercase font-bold tracking-wider" style="color: var(--text-muted)" data-i18n="pro_add_pokemon">Add Pokemon</span>
                    </button>
                </div>
            </section>

            <section id="pro-analysis-section" class="panel text-center"></section>
        </div>

        <!-- SEO Content Section — visually separated from the tool -->
        <section class="mt-16 pt-12" style="border-top: 1px solid var(--border)">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-xl font-black mb-5" style="color: var(--text)" data-i18n="mastering_chart">
                    Mastering the Pokemon Type Chart
                </h2>

                <p class="leading-relaxed mb-6" style="color: var(--text-muted)" data-i18n="chart_desc">
                    Understanding type effectiveness is crucial for any Pokemon trainer, whether you're playing Pokemon Scarlet and Violet (Gen 9) or classic titles.
                    Our Pokemon Type Calculator helps you instantly find weaknesses, resistances, and immunities for any single or dual-type Pokemon.
                </p>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="panel">
                        <h3 class="text-sm font-bold mb-2" style="color: var(--text)" data-i18n="effectiveness_title">How Effectiveness Works</h3>
                        <p class="text-sm leading-relaxed" style="color: var(--text-muted)" data-i18n="effectiveness_desc">
                            Every attack in the game has a type modifier. A standard attack deals 1x damage.
                            If a move is Super Effective, it deals 2x damage. If it's Not Very Effective, it deals 0.5x damage.
                            Immunities result in 0x damage, meaning the attack has no effect at all.
                        </p>
                    </div>

                    <div class="panel">
                        <h3 class="text-sm font-bold mb-2" style="color: var(--text)" data-i18n="dual_title">Dual Type Weaknesses</h3>
                        <p class="text-sm leading-relaxed" style="color: var(--text-muted)" data-i18n="dual_desc">
                            Many Pokemon possess two types (e.g., Charizard is Fire/Flying). Weaknesses stack!
                            If both types are weak to the same element (like Rock vs. Fire/Flying), the damage multiplier becomes 4x.
                            Conversely, resistances can cancel out weaknesses.
                        </p>
                    </div>
                </div>

                <div class="mt-10 space-y-4">
                    <h3 class="text-lg font-bold" style="color: var(--text)" data-i18n="faq_title">Frequently Asked Questions</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="pb-3" style="border-bottom: 1px solid var(--border)">
                            <h4 class="font-bold mb-1 text-sm" style="color: var(--text)" data-i18n="faq_q1">What is the best Pokemon type?</h4>
                            <p class="text-sm" style="color: var(--text-muted)" data-i18n="faq_a1">While it depends on the strategy, the **Steel** type is often considered the best defensive type due to its numerous resistances, while **Fairy** and **Dragon** are top-tier offensive types in Gen 9.</p>
                        </div>
                        <div class="pb-3" style="border-bottom: 1px solid var(--border)">
                            <h4 class="font-bold mb-1 text-sm" style="color: var(--text)" data-i18n="faq_q2">How to calculate dual type weaknesses?</h4>
                            <p class="text-sm" style="color: var(--text-muted)" data-i18n="faq_a2">To calculate dual type effectiveness, multiply the modifiers of both types. For example, if both types are weak to Water, the Pokemon takes 4x damage.</p>
                        </div>
                        <div class="pb-3" style="border-bottom: 1px solid var(--border)">
                            <h4 class="font-bold mb-1 text-sm" style="color: var(--text)" data-i18n="faq_q3">What are the new types in Gen 9?</h4>
                            <p class="text-sm" style="color: var(--text-muted)" data-i18n="faq_a3">Pokemon Scarlet and Violet (Gen 9) maintains the 18 standard types but introduces the **Terastal** phenomenon, allowing Pokemon to change their type mid-battle.</p>
                        </div>
                        <div class="pb-3" style="border-bottom: 1px solid var(--border)">
                            <h4 class="font-bold mb-1 text-sm" style="color: var(--text)" data-i18n="faq_q4">Is there a 0x damage type?</h4>
                            <p class="text-sm" style="color: var(--text-muted)" data-i18n="faq_a4">Yes, **Immunities** result in 0x damage. For example, Ghost types are immune to Normal and Fighting moves, and Ground types are immune to Electric attacks.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Contact & Feedback Section -->
        <section class="panel flex flex-col md:flex-row items-center justify-between gap-6 mt-8">
            <div class="flex-1 text-center md:text-left">
                <h2 class="text-lg font-bold mb-1" style="color: var(--text)" data-i18n="suggestions_title">Got suggestions or feedback?</h2>
                <p style="color: var(--text-muted)" data-i18n="suggestions_desc">
                    I'm always looking to improve PokeTypes. Whether it's a feature request or a bug report, I'd love to hear from you!
                </p>
            </div>

            <div class="flex flex-wrap justify-center items-center gap-3">
                <div id="discord-btn" class="relative group cursor-pointer flex items-center gap-2 px-3 py-2 rounded-md border text-sm font-bold select-none" style="background: rgba(88,101,242,0.1); border-color: rgba(88,101,242,0.25); color: #5865F2" title="Click to copy username">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-2.595-9.133-4.833-12.724a.076.076 0 0 0-.038-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.086 2.157 2.419 0 1.334-.956 2.42-2.157 2.42zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.086 2.157 2.419 0 1.334-.946 2.42-2.157 2.42z"/></svg>
                    <span id="discord-text">xarli11</span>
                    <span id="discord-tooltip" class="absolute -top-8 left-1/2 -translate-x-1/2 text-white bg-slate-800 text-xs py-1 px-2 rounded opacity-0 transition-opacity pointer-events-none">Copied!</span>
                </div>

                <a href="mailto:carlosgt2001@icloud.com" class="flex items-center gap-2 px-3 py-2 rounded-md border text-sm font-bold transition-colors" style="border-color: var(--border); color: var(--text-muted)">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                    <span data-i18n="email_btn">Email Me</span>
                </a>

                <a href="https://buymeacoffee.com/xarli11" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 rounded-md text-sm font-bold" style="background: #FFDD00; color: #14181F">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 1v3M10 1v3M14 1v3" />
                    </svg>
                    <span data-i18n="bmc_btn">Buy Me a Coffee</span>
                </a>

                <a href="https://github.com/Xarli11" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 px-3 py-2 rounded-md text-sm font-bold bg-slate-900 text-white">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.42-1.305.763-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
                    <span>GitHub</span>
                </a>
            </div>
        </section>

        <footer class="mt-10 text-center text-sm" style="color: var(--text-muted)">
            <p>&copy; 2026 Poketypes &bull; <span data-i18n="footer_copyright">Data up to Gen 9</span></p>
            <p class="mt-1"><span data-i18n="created_by">Created by</span> Xarli11</p>
        </footer>
    </div>

    <!-- Search Modal (Pro Mode) -->
    <div id="search-modal" class="fixed inset-0 z-[100] hidden" aria-labelledby="search-modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-black/50 transition-opacity opacity-0" id="search-backdrop"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-start justify-center p-4 text-center sm:p-0">
                <div class="relative surface-raised text-left transition-all sm:my-20 sm:w-full sm:max-w-xl scale-95 opacity-0 overflow-hidden" id="search-panel">
                    <h2 id="search-modal-title" class="sr-only" data-i18n="pro_add_pokemon">Add Pokemon</h2>
                    <div class="px-4 py-3 sm:px-5 flex items-center gap-3" style="border-bottom: 1px solid var(--border)">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--text-muted)">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" id="pro-search-input" class="w-full bg-transparent border-none focus:ring-0 focus:outline-none text-base font-medium" style="color: var(--text)" placeholder="Search Pokemon..." autocomplete="off">
                        <button id="close-search-modal" class="icon-btn" type="button">
                            <span class="sr-only" data-i18n="close_btn">Close</span>
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    <div class="max-h-[60vh] overflow-y-auto" id="pro-search-results">
                        <div class="py-10 text-center text-sm" style="color: var(--text-muted)">
                            Type to start searching...
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="delete-modal" class="fixed inset-0 z-[110] hidden" aria-labelledby="delete-modal-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-black/50 transition-opacity opacity-0" id="delete-backdrop"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-center justify-center p-4 text-center">
                <div class="relative surface-raised text-left transition-all sm:w-full sm:max-w-sm scale-95 opacity-0 p-5" id="delete-panel">
                    <h3 id="delete-modal-title" class="text-base font-bold mb-1" style="color: var(--text)" data-i18n="confirm_delete_title">Remove Pokemon?</h3>
                    <p class="text-sm mb-5" style="color: var(--text-muted)" data-i18n="confirm_delete_msg">Are you sure you want to remove this Pokemon from your team?</p>
                    <div class="flex justify-end gap-2">
                        <button id="cancel-delete" class="px-3 py-2 rounded-md text-sm font-bold transition-colors" style="color: var(--text-muted)" data-i18n="btn_cancel" type="button">Cancel</button>
                        <button id="confirm-delete" class="px-3 py-2 rounded-md text-sm font-bold text-white bg-red-500 hover:bg-red-600 transition-colors" data-i18n="btn_remove" type="button">Remove</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Team Member Configuration Modal -->
    <div id="member-config-modal" class="fixed inset-0 z-[110] hidden" aria-labelledby="member-config-title" role="dialog" aria-modal="true">
        <div class="fixed inset-0 bg-black/50 transition-opacity opacity-0" id="member-config-backdrop"></div>
        <div class="fixed inset-0 z-10 overflow-y-auto">
            <div class="flex min-h-full items-end sm:items-center justify-center sm:p-4 text-center">
                <div class="relative surface-raised text-left transition-all w-full sm:max-w-md translate-y-full sm:translate-y-0 sm:scale-95 opacity-0 p-5 rounded-b-none sm:rounded-b-[var(--radius-lg)]" id="member-config-panel">
                    <div class="flex items-center justify-between mb-4">
                        <h3 id="member-config-title" class="text-base font-bold" style="color: var(--text)" data-i18n="member_config_title">Configure Pokemon</h3>
                        <button id="close-member-config" class="icon-btn" type="button">
                            <span class="sr-only" data-i18n="close_btn">Close</span>
                            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    <div id="member-config-body" class="flex flex-col gap-4"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="../js/main.js"></script>
</Layout>
