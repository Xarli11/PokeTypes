---
import '../styles/global.css';
import { normalizePathname } from '../lib/seo.js';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    canonicalPath?: string;
    robots?: string;
}

const {
    title = "PokeTypes | Pokemon Type Calculator & Effectiveness Chart",
    description = "Instant Pokemon type calculator and effectiveness chart. Analyze weaknesses, resistances, and dual-type coverage for all 1,000+ Pokemon (Gen 9, Scarlet/Violet included).",
    image = "/icon-512.png",
    canonicalPath,
    robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
} = Astro.props;

const siteUrl = "https://poketypes.app";
const canonicalURL = `${siteUrl}${canonicalPath ?? normalizePathname(Astro.url.pathname)}`;
const finalImageUrl = image.startsWith('http') ? image : `${siteUrl}${image}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Primary SEO -->
    <title>{title}</title>
    <meta name="description" content={description}>
    <meta name="keywords" content="pokemon type calculator, pokemon weakness chart, type effectiveness, pokemon SV, Gen 9, dual type calculator, resistance checker, pokemon scarlet violet, pokedex type chart">
    <meta name="author" content="Xarli11">
    <meta name="robots" content={robots}>
    <link rel="canonical" href={canonicalURL}>

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="PokeTypes">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={finalImageUrl}>
    <meta property="og:locale" content="en_US">

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@poketypesapp">
    <meta name="twitter:url" content={canonicalURL}>
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={finalImageUrl}>

    <!-- Icons & PWA -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png">
    <link rel="icon" type="image/png" sizes="512x512" href="/icon-512.png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#F6F7F9">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="PokeTypes">
    <meta name="mobile-web-app-capable" content="yes">

    <!-- DNS Prefetch / Preconnect -->
    <link rel="dns-prefetch" href="https://raw.githubusercontent.com">
    <link rel="dns-prefetch" href="https://pokeapi.co">
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com">

    <!-- Fonts are self-hosted (src/styles/fonts.css): no request to Google Fonts before consent. Preload the two latin faces used on every page. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/syne-latin.woff2" crossorigin>
    <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-latin.woff2" crossorigin>

    <!-- Consent Mode v2, basic implementation. Defaults deny every signal and gtag.js is NOT
         requested until Google's CMP (AdSense > Privacy & messaging) reports consent mode data
         (googlefc CONSENT_MODE_DATA_READY) and analytics_storage is explicitly GRANTED. Nothing is
         sent to Google Analytics otherwise: not applicable, not configured, unknown and denied all
         keep it blocked (no cookieless pings). The same live status gates every trackEvent() call
         (window.pokeAnalyticsGranted) and, once gtag.js is loaded, every hit ('ga-disable' flag), so
         events from before consent are never queued and a withdrawal takes effect without reload.
         See docs/privacy-consent.md. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'analytics_storage': 'denied',
        'wait_for_update': 500
      });
      window.googlefc = window.googlefc || {};
      window.googlefc.callbackQueue = window.googlefc.callbackQueue || [];
      (function () {
        var loaded = false;
        var mirrored = {};
        // ConsentModePurposeStatusEnum: 1 GRANTED, 2 DENIED, 3 NOT_APPLICABLE, 4 NOT_CONFIGURED, 0 UNKNOWN
        var SIGNALS = {
          ad_storage: 'adStoragePurposeConsentStatus',
          ad_user_data: 'adUserDataPurposeConsentStatus',
          ad_personalization: 'adPersonalizationPurposeConsentStatus',
          analytics_storage: 'analyticsStoragePurposeConsentStatus'
        };
        function status() {
          try { return window.googlefc.getGoogleConsentModeValues(); } catch (e) { return {}; }
        }
        // A signal is granted only while the CMP reports GRANTED; every other status is denied.
        // Only changes are pushed, so nothing is granted by default and a withdrawal is mirrored.
        function mirror() {
          var values = status();
          var update = {};
          for (var signal in SIGNALS) {
            var next = values[SIGNALS[signal]] === 1 ? 'granted' : 'denied';
            if ((mirrored[signal] || 'denied') !== next) { mirrored[signal] = next; update[signal] = next; }
          }
          if (Object.keys(update).length) gtag('consent', 'update', update);
          return values[SIGNALS.analytics_storage] === 1;
        }
        window.pokeAnalyticsGranted = mirror;
        Object.defineProperty(window, 'ga-disable-G-9D59NL7KTH', {
          get: function () { return status()[SIGNALS.analytics_storage] !== 1; }
        });
        window.googlefc.callbackQueue.push({
          CONSENT_MODE_DATA_READY: function () {
            if (!mirror() || loaded) return;
            loaded = true;
            gtag('js', new Date());
            gtag('config', 'G-9D59NL7KTH');
            var tag = document.createElement('script');
            tag.async = true;
            tag.src = 'https://www.googletagmanager.com/gtag/js?id=G-9D59NL7KTH';
            document.head.appendChild(tag);
          }
        });
      })();
    </script>

    <!-- Google AdSense (also delivers the CMP message; no ad units or Auto ads are enabled from code) -->
    <script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-5778743399428042" crossorigin="anonymous"></script>

    <!-- Theme (prevent FOUC) -->
    <script is:inline>
      var isDark = localStorage.theme === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', isDark);
      var themeColorMeta = document.querySelector('meta[name="theme-color"]');
      if (themeColorMeta) themeColorMeta.setAttribute('content', isDark ? '#0B0E14' : '#F6F7F9');
    </script>

    <!-- Base WebApplication Schema -->
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "@id": "https://poketypes.app/#webapp",
      "name": "PokeTypes",
      "alternateName": "Pokemon Type Calculator",
      "url": "https://poketypes.app/",
      "description": "Advanced Pokemon type calculator and effectiveness chart for Gen 9 (Scarlet & Violet). Check weaknesses, resistances, immunities and dual-type coverage instantly.",
      "applicationCategory": "GameApplication",
      "applicationSubCategory": "Strategy",
      "genre": "Pokemon strategy",
      "operatingSystem": "Any",
      "inLanguage": ["en", "es"],
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "featureList": [
        "Pokemon type weakness calculator",
        "Dual-type coverage analysis",
        "Team Builder with 6-slot roster",
        "Gen 9 (Scarlet & Violet) support",
        "1,000+ Pokemon database",
        "Mobile-friendly PWA",
        "Interactive type chart",
        "Tactical advisor"
      ],
      "potentialAction": {
        "@type": "SearchAction",
        "target": {
          "@type": "EntryPoint",
          "urlTemplate": "https://poketypes.app/pokemon/{search_term_string}"
        },
        "query-input": "required name=search_term_string"
      },
      "author": {
        "@type": "Person",
        "name": "Xarli11",
        "url": "https://github.com/Xarli11"
      },
      "publisher": {
        "@type": "Person",
        "name": "Xarli11"
      }
    }
    </script>

    <!-- Page-specific head content (JSON-LD, etc.) -->
    <slot name="head" />
</head>
<body class="min-h-screen py-4 sm:py-6 md:py-8 px-4 md:px-8 transition-colors duration-200">
    <slot />
</body>
</html>
