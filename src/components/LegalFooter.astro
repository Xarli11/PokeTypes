---
// Legal links shown on every page. The settings button reopens Google's CMP
// (AdSense "European regulations" message); until that message is published
// or if it is blocked, it falls back to the cookies section of /privacy.
---

<nav aria-label="Legal" class="mt-3 flex flex-wrap justify-center gap-x-4 gap-y-1">
    <a href="/privacy" class="underline py-1" data-i18n="footer_privacy">Privacy Policy</a>
    <a href="/privacy#cookies" class="underline py-1" data-i18n="footer_cookies">Cookies</a>
    <button type="button" id="privacy-settings" class="underline py-1" data-i18n="footer_privacy_settings">Privacy and cookie settings</button>
</nav>

<script is:inline>
    document.getElementById('privacy-settings')?.addEventListener('click', function () {
        var fc = window.googlefc;
        if (fc && fc.callbackQueue && typeof fc.showRevocationMessage === 'function') {
            fc.callbackQueue.push(fc.showRevocationMessage);
        } else if (location.pathname === '/privacy') {
            location.hash = 'cookies';
        } else {
            location.href = '/privacy#cookies';
        }
    });
</script>
